[
 {
  "de": 0.274,
  "ate": 4.1,
  "linhas": [
   "Em 993 o Sol soltou uma tempestade",
   "de partículas tão grande"
  ]
 },
 {
  "de": 4.1,
  "ate": 7.557,
  "linhas": [
   "que ela ficou registrada em todas",
   "as árvores vivas do planeta"
  ]
 },
 {
  "de": 7.772,
  "ate": 8.731,
  "linhas": [
   "ao mesmo tempo."
  ]
 },
 {
  "de": 9.309,
  "ate": 11.821,
  "linhas": [
   "Um pico de carbono-14,"
  ]
 },
 {
  "de": 12.073,
  "ate": 13.825,
  "linhas": [
   "no anel daquele ano."
  ]
 },
 {
  "de": 14.371,
  "ate": 15.922,
  "linhas": [
   "Em L’Anse aux Meadows,",
   "na ponta norte da Terra Nova,"
  ]
 },
 {
  "de": 16.144,
  "ate": 18.084,
  "linhas": [
   "tem madeira cortada",
   "por machado de metal."
  ]
 },
 {
  "de": 18.533,
  "ate": 20.285,
  "linhas": [
   "Os nórdicos tinham machado de metal."
  ]
 },
 {
  "de": 20.536,
  "ate": 21.931,
  "linhas": [
   "Os habitantes do lugar, não."
  ]
 },
 {
  "de": 22.549,
  "ate": 26.61,
  "linhas": [
   "Então os pesquisadores acharam",
   "o anel de 993 nessa madeira"
  ]
 },
 {
  "de": 26.73,
  "ate": 27.597,
  "linhas": [
   "e contaram para fora,"
  ]
 },
 {
  "de": 27.815,
  "ate": 29.831,
  "linhas": [
   "um anel por ano, até a casca."
  ]
 },
 {
  "de": 30.213,
  "ate": 32.159,
  "linhas": [
   "Vinte e oito anéis."
  ]
 },
 {
  "de": 32.89,
  "ate": 34.312,
  "linhas": [
   "Mil e vinte e um."
  ]
 },
 {
  "de": 35.363,
  "ate": 36.6,
  "linhas": [
   "Não “por volta do ano mil”."
  ]
 },
 {
  "de": 36.6,
  "ate": 37.958,
  "linhas": [
   "O ano exato em que a árvore caiu."
  ]
 },
 {
  "de": 38.423,
  "ate": 41.667,
  "linhas": [
   "Que outra data da história antiga",
   "você sabe com essa precisão?"
  ]
 }
]