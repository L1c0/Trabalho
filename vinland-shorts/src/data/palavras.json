"cues": [
{
"de": 0.0,
"ate": 100.2,
"linhas": [
"Tudo que a gente sabe sobre a",
"viagem dos nórdicos para a América"
]
},
{
"de": 102.0,
"ate": 178.2,
"linhas": [
"vem de duas sagas islandesas."
]
},
{
"de": 180.0,
"ate": 208.2,
"linhas": [
"E elas discordam em quase tudo."
]
},
{
"de": 210.0,
"ate": 328.2,
"linhas": [
"Uma diz sessenta homens. A",
"outra diz cento e quarenta."
]
},
{
"de": 330.0,
"ate": 478.2,
"linhas": [
"Uma dá ao Thorfinn o crédito por",
"coisas que a outra atribui a outras pessoas."
]
},
{
"de": 480.0,
"ate": 598.2,
"linhas": [
"As duas foram escritas mais de",
"duzentos anos depois dos fatos."
]
},
{
"de": 600.0,
"ate": 703.2,
"linhas": [
"E a cópia mais antiga que sobrou",
"de uma delas foi feita por um homem"
]
},
{
"de": 705.0,
"ate": 838.2,
"linhas": [
"chamado Haukr Erlendsson,",
"que dizia descender do Thorfinn."
]
},
{
"de": 840.0,
"ate": 928.2,
"linhas": [
"Quando a gente diz que a",
"história desmente Vinland,"
]
},
{
"de": 930.0,
"ate": 1003.2,
"linhas": [
"está citando um texto",
"que já foi mexido por alguém"
]
},
{
"de": 1005.0,
"ate": 1048.2,
"linhas": [
"que queria contar uma história melhor."
]
},
{
"de": 1050.0,
"ate": 1255.2,
"linhas": [
"Em quem você acredita quando as",
"duas fontes são a única coisa que existe?"
]
}
]
},
