"cues": [
{
"de": 0.0,
"ate": 145.2,
"linhas": [
"No capítulo 96 de Vinland Saga,",
"o Thorfinn leva cem socos na cara."
]
},
{
"de": 147.0,
"ate": 199.2,
"linhas": [
"Ele não revida nenhum."
]
},
{
"de": 201.0,
"ate": 322.2,
"linhas": [
"O Yukimura desenha a contagem na",
"página: dezessete, dezoito, dezenove."
]
},
{
"de": 324.0,
"ate": 358.2,
"linhas": [
"E a contagem é o argumento."
]
},
{
"de": 360.0,
"ate": 439.2,
"linhas": [
"Não é uma surra dramática, é uma conta."
]
},
{
"de": 441.0,
"ate": 526.2,
"linhas": [
"Cem é um número que você",
"consegue imaginar inteiro."
]
},
{
"de": 528.0,
"ate": 643.2,
"linhas": [
"No fim o Thorfinn está",
"destruído, de pé, e diz quatro palavras:"
]
},
{
"de": 645.0,
"ate": 706.2,
"linhas": [
"eu não tenho inimigos."
]
},
{
"de": 708.0,
"ate": 779.1,
"linhas": [
"Quantos você aguentaria antes de revidar?"
]
}
]
},
